@startuml 05-secuencia-unirse-plan
!include estilo.iuml
title Unirse a la última plaza con dos peticiones simultáneas
autonumber

actor "Usuario A" as A
actor "Usuario B" as B
participant "API Gateway" as GW
participant "plans" as P
database "Redis" as R
database "PostgreSQL" as DB
queue "RabbitMQ" as MQ

par Peticiones simultáneas
  A -> GW : POST /plans/{id}/participants
  GW -> P : unirse(A)
else
  B -> GW : POST /plans/{id}/participants
  GW -> P : unirse(B)
end

group Usuario A obtiene el bloqueo
  P -> R : SET lock:plan:{id} NX PX 5000
  R --> P : OK
  P -> DB : UPDATE plan SET ocupadas = ocupadas + 1\nWHERE id = ? AND ocupadas < plazas
  DB --> P : 1 fila actualizada
  P -> R : DEL lock:plan:{id}
  P -> MQ : PlanCompletado
  P --> A : 201 Created
end

group Usuario B, cuando se libera el bloqueo
  P -> R : SET lock:plan:{id} NX PX 5000
  R --> P : OK
  P -> DB : UPDATE ... WHERE ocupadas < plazas
  DB --> P : 0 filas actualizadas
  P -> R : DEL lock:plan:{id}
  P --> B : 409 Conflict (plan completo)
end

note over P, DB
  La condición «ocupadas < plazas» en la propia sentencia
  garantiza RNF-03 aunque falle el bloqueo distribuido.
end note
@enduml
