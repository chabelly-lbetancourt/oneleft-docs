@startuml 29-secuencia-aviso-plan-cercano
!include estilo.iuml
title HU-006 · Ana publica un plan y Lucía recibe el aviso

actor "Ana\n(organizadora)" as A
participant "plans" as P
queue "RabbitMQ" as MQ
participant "notifications\nNearbyPlanNotifier" as N
database "notifications\n(PostgreSQL)" as DB
participant "Servicio de push\ndel navegador" as PS
actor "Lucía\n(avisos activados)" as L

A -> P : POST /api/v1/plans
P -> MQ : plan.published\n(título, lugar, hora, plazas)
MQ -> N : cola notifications.plan-published
N -> DB : preferencias activadas\npara PÁDEL (o todas)
loop cada persona que quiere el plan
  N -> N : distancia ≤ radio · no es quien organiza\nfuera del horario sin avisos
  N -> DB : ¿menos avisos hoy que su máximo?\n¿no avisada ya de este plan?
  N -> DB : registrar aviso
  N -> MQ : notification.nearby-plan
  MQ -> P : cola anónima de cada réplica
  P -> L : SSE plan-nearby\n(si tiene OneLeft abierto)
  N -> PS : Web Push cifrado (RFC 8291)\nfirmado con VAPID
  PS -> L : notificación del sistema\n(aunque OneLeft esté cerrado)
end
L -> L : toca el aviso → /plans/{id}
@enduml
