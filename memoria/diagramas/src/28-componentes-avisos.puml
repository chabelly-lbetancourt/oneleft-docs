@startuml 28-componentes-avisos
!include estilo.iuml
title HU-006 · Avisos de planes cercanos: componentes
skinparam componentStyle rectangle

package "Web (Angular)" {
  component "Página de avisos\n/notifications" as PAGE
  component "UserEvents\n(un solo flujo SSE)" as EVENTS
  component "WebPush\n(Push API)" as WP
  component "Service worker\npush-sw.js" as SW
}

component "Gateway\n/api/v1/notifications/**" as GW

node "plans" {
  component "PlanService" as PLANS
  component "UserEventSubscriptions\n(flujo personal SSE)" as SSE
}

node "notifications" {
  component "NotificationController" as API
  component "NearbyPlanNotifier\nzona · radio · actividades\nhorario sin avisos · máximo diario" as NOTIFIER
  component "WebPushSender\nRFC 8291 + VAPID (RFC 8292)" as SENDER
  database "notifications\npreferencias · suscripciones\navisos enviados" as DB
}

queue "RabbitMQ\noneleft.plans\nplan.published" as PLANQ
queue "RabbitMQ\noneleft.notifications\nnotification.nearby-plan" as NOTQ
cloud "Servicio de push\ndel navegador\n(Google, Mozilla, Apple)" as PUSH

PAGE --> GW : preferencias,\nsuscripción
WP --> GW : clave VAPID,\nsuscripción
GW --> API
API --> DB
PLANS --> PLANQ : plan publicado
PLANQ --> NOTIFIER : cola duradera\ncompartida
NOTIFIER --> DB : ¿a quién?\nuna vez por plan
NOTIFIER --> NOTQ : aviso para la app
NOTQ --> SSE : cola anónima\n(todas las réplicas)
SSE --> EVENTS : plan-nearby
NOTIFIER --> SENDER
SENDER --> PUSH : mensaje cifrado\ny firmado
PUSH --> SW : aunque OneLeft\nesté cerrado
@enduml
