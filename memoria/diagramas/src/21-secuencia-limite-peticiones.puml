@startuml 21-secuencia-limite-peticiones
!include estilo.iuml
title Límite de peticiones en el gateway (token bucket compartido en Redis)

actor "Usuario\n(web o Android)" as U
participant "gateway\nSpring Security" as SEC
participant "RateLimitFilter" as RL
database "Redis\ncubo por regla y usuario" as R
participant "plans" as P

U -> SEC : POST /api/v1/plans (Bearer JWT)
SEC -> SEC : valida el JWT
SEC -> RL : petición autenticada
RL -> RL : primera regla que coincide\n«publish-plans»: 5 por hora
RL -> R : tryConsumeAndReturnRemaining(1)\nclave publish-plans:user:<sub> (CAS)
alt quedan fichas
  R --> RL : consumida, quedan N
  RL -> P : reenvía la petición
  P --> U : 201 Created\nX-RateLimit-Remaining: N
else cubo vacío
  R --> RL : rechazada, recarga en T s
  RL -> RL : métrica ratelimit.rejected{rule}
  RL --> U : 429 Problem Details\ncode rate.limited, Retry-After: T
else Redis no responde
  RL -> RL : métrica ratelimit.unavailable
  RL -> P : reenvía (falla en abierto)
end
@enduml
