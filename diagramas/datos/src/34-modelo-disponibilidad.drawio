        <mxCell id="e2" value="ST_DWithin 5 km (solo para quien organiza)" style="endArrow=open;dashed=1;html=1;strokeColor=#A8A29E;fontFamily=Helvetica;fontSize=11;fontColor=#57534E;" edge="1" parent="1" source="plan-3" target="av-2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="367"/><mxPoint x="20" y="118"/></Array></mxGeometry></mxCell>
        <mxCell id="note" value="Quien organiza un plan que aún no ha empezado ve a la gente libre a menos de 5 km que haría su actividad, como FreePerson: distancia redondeada a 500 m desde la zona aproximada, nivel en la actividad y otras actividades. Nunca el user_id, el nombre ni el lugar. La fila se borra al desactivar, al unirse a un plan (también desde la lista de espera) y, caducada, por la limpieza cada 10 minutos." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#F5F5F4;strokeColor=#A8A29E;fontColor=#1C1917;fontFamily=Helvetica;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="200" width="280" height="190" as="geometry"/></mxCell>
