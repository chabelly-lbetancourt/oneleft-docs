        <mxCell id="e1" value="seguidor / seguido" style="endArrow=open;html=1;strokeColor=#78716C;fontFamily=Helvetica;fontSize=11;fontColor=#57534E;" edge="1" parent="1" source="follow-0" target="person-0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="misma persona (sin clave foránea)" style="endArrow=open;dashed=1;html=1;strokeColor=#A8A29E;fontFamily=Helvetica;fontSize=11;fontColor=#57534E;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="activity-1" target="person-0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="filtra (user_id, plan_id)" style="endArrow=open;dashed=1;html=1;strokeColor=#A8A29E;fontFamily=Helvetica;fontSize=11;fontColor=#57534E;" edge="1" parent="1" source="hidden-1" target="activity-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Fan-out al leer: cada actividad se guarda una vez, para quien la hace, y el feed de alguien se calcula al pedirlo con la actividad de quienes sigue con el seguimiento aceptado, que comparten su actividad (feed_audience) y sin los planes que ocultaron. Seguir, dejar de seguir, aceptar u ocultar se nota al momento, y una actividad cuesta una escritura, tenga los seguidores que tenga. Sin claves foráneas a person: la actividad de alguien que aún no usa social se guarda para quien le siga después, y cualquiera puede ocultar un plan. Mientras alguien comparte con «nadie», ni se guarda su actividad nueva." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#F5F5F4;strokeColor=#A8A29E;fontColor=#1C1917;fontFamily=Helvetica;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1000" height="90" as="geometry"/></mxCell>
