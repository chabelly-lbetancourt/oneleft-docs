@startuml 07-despliegue-aws
!include ../../estilo.iuml
title Diagrama de despliegue en AWS Lightsail (un entorno: pre o pro)

actor "Usuarios\nweb y Android" as USR
node "GitHub Actions" as GHA
database "GitHub Container\nRegistry (GHCR)" as GHCR

rectangle "AWS" {
  component "Zona DNS e IP estática\nde Lightsail" as DNS
  component "Amazon SES\ncorreo de Keycloak" as SES
  component "AWS Budgets y alarmas\nde Lightsail" as BUD
  component "Almacenamiento de objetos\nLightsail (copias pg_dump)" as BK

  node "Instancia Lightsail · Linux · 2 vCPU · 8 GB\nDocker Compose" as LS {
    component "Caddy\nHTTPS (Let's Encrypt)\napp Angular · /api · /auth" as CAD
    component "gateway" as GWP
    component "users · plans\nnotifications" as SVC
    component "Keycloak" as KCP
    database "PostgreSQL\n+ PostGIS" as PGP
    queue "RabbitMQ" as MQP
    database "Redis" as RDP
    component "Prometheus · Loki\nGrafana" as OBS
  }
}

USR --> DNS
DNS --> CAD
CAD --> GWP : /api
CAD --> KCP : /auth
GWP --> SVC
GWP --> RDP : límite de peticiones
SVC --> PGP
SVC --> MQP
KCP --> PGP
KCP ..> SES : correos
SVC ..> OBS : métricas y logs
PGP ..> BK : copia diaria
GHA --> GHCR : imágenes :pre / :latest
GHA --> LS : SSH: docker compose pull && up -d
LS ..> GHCR : pull
@enduml
