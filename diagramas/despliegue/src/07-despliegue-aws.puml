@startuml 07-despliegue-aws
!include ../../estilo.iuml
title Diagrama de despliegue en AWS

actor "Usuarios\nweb y Android" as USR
node "GitHub Actions" as GHA

rectangle "AWS" as AWS {
  component "Route 53 + ACM\ndominio y TLS" as R53
  component "CloudFront + S3\napp Angular" as CF
  component "ECR\nimágenes Docker" as ECR
  component "Secrets Manager" as SM
  component "AWS Budgets\nalertas de coste" as BUD

  node "VPC · eu-south-2 (España)" as VPC {
    component "Application\nLoad Balancer" as ALB

    node "Clúster Kubernetes\nEKS o k3s en EC2" as K8S {
      component "Ingress" as ING
      component "gateway" as GWP
      component "users · plans · geo\nnotifications · chat · ai\n(HPA: autoescalado)" as SVC
      component "Keycloak" as KCP
      queue "RabbitMQ" as MQP
      component "Grafana · Loki\nPrometheus" as OBS
    }

    database "Amazon RDS\nPostgreSQL + PostGIS" as RDS
    database "ElastiCache\nRedis" as EC
  }
}

USR --> R53
R53 --> CF
R53 --> ALB
ALB --> ING
ING --> GWP
GWP --> SVC
SVC --> RDS
SVC --> EC
SVC --> MQP
SVC ..> SM : secretos
SVC ..> OBS : logs y métricas
GHA --> ECR : push de imágenes
GHA --> K8S : despliegue
K8S ..> ECR : pull
@enduml
