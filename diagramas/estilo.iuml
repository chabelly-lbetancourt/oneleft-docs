' Estilo común de los diagramas de OneLeft
skinparam backgroundColor white
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #475569
skinparam ArrowFontSize 11
skinparam ArrowFontColor #334155
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam NoteBackgroundColor #FFF7ED
skinparam NoteBorderColor #FB923C

skinparam class {
  BackgroundColor #FFF7ED
  BorderColor #EA580C
  HeaderBackgroundColor #FFEDD5
  AttributeFontSize 12
}
skinparam component {
  BackgroundColor #FFF7ED
  BorderColor #EA580C
}
skinparam database {
  BackgroundColor #F1F5F9
  BorderColor #475569
}
skinparam queue {
  BackgroundColor #F1F5F9
  BorderColor #475569
}
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #64748B
}
skinparam cloud {
  BackgroundColor #F8FAFC
  BorderColor #64748B
}
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #64748B
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}
skinparam usecase {
  BackgroundColor #FFF7ED
  BorderColor #EA580C
}
skinparam actor {
  BackgroundColor #FFEDD5
  BorderColor #EA580C
}
skinparam state {
  BackgroundColor #FFF7ED
  BorderColor #EA580C
}
skinparam sequence {
  ParticipantBackgroundColor #FFF7ED
  ParticipantBorderColor #EA580C
  ActorBackgroundColor #FFEDD5
  ActorBorderColor #EA580C
  LifeLineBorderColor #94A3B8
  GroupBackgroundColor #F1F5F9
}
skinparam activity {
  BackgroundColor #FFF7ED
  BorderColor #EA580C
  StartColor #EA580C
  EndColor #EA580C
  BarColor #475569
}
