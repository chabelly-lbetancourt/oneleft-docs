@startuml 20-secuencia-unirse-plan
!include ../../estilo.iuml
title HU-005 · Dos personas piden la última plaza a la vez (bloqueo optimista)

actor "Lucía" as L
actor "Diego" as D
participant "plans\nJoinPlanService" as S
database "PostgreSQL\nplan (version)" as DB
queue "RabbitMQ\nplan.joined" as MQ
actor "Organizadora\n(app abierta)" as O

par
  L -> S : POST /plans/{id}/participants
  S -> DB : SELECT plan (1 plaza libre, version 7)
else
  D -> S : POST /plans/{id}/participants
  S -> DB : SELECT plan (1 plaza libre, version 7)
end

S -> S : Plan.join(Lucía) → FULL
S -> DB : UPDATE ... SET occupied = 1, version = 8\nWHERE id = ? AND version = 7
DB --> S : 1 fila ✔
S -> MQ : plan.joined (después del commit)
S --> L : 200 · estás dentro

S -> S : Plan.join(Diego)
S -> DB : UPDATE ... WHERE id = ? AND version = 7
DB --> S : 0 filas → ConcurrentPlanUpdateException
S -> DB : reintento: SELECT plan (version 8, FULL)
S -> S : Plan.join(Diego) → JoinRejectedException
S --> D : 409 · code = plan.full

MQ -> O : SSE plan-joined\n«Lucía se ha unido a tu plan»
@enduml
