@startuml 10-pipeline-ci
!include ../../estilo.iuml
title Pipeline de integración continua (GitHub Actions)

start
:Pull request contra dev, pre o main
o push a dev, pre o main;

fork
  partition "lint (todos los repositorios)" {
    :Validar nombre de rama\n(issue#N, hotfix/..., dev, pre);
    :Validar camino de promoción\n(issue#N → dev → pre → main;\nhotfix/* → main, pre, dev);
    :Validar commits\n(Conventional Commits + #issue);
  }
fork again
  partition "oneleft-backend · ci" {
    :./mvnw verify\n(Java 21, tests JUnit + ArchUnit);
    if (Cobertura JaCoCo ≥ 80 %?) then (sí)
      :Informe de cobertura\ny resumen del job;
      if (SONAR_TOKEN configurado?) then (sí)
        :Análisis en SonarQube Cloud\n(quality gate);
      endif
      :Imagen Docker por servicio\n(gateway, users, plans);
      if (push a pre?) then (sí)
        :Publicar en GHCR\n(:pre y :sha) → entorno pre;
      elseif (push a main?) then (sí)
        :Publicar en GHCR\n(:latest y :sha) → entorno pro;
      endif
    else (no)
      :Build fallido; <<#FECACA>>
      stop
    endif
  }
fork again
  partition "oneleft-frontend · ci" {
    :npm ci (Node 24 LTS);
    :ng lint (angular-eslint);
    if (Tests Vitest y cobertura ≥ 80 %?) then (sí)
      :ng build (configuración pre en pre,\nproduction en el resto;\nlicencia PrimeNG desde secreto);
      :Artefacto con build y cobertura;
      if (SONAR_TOKEN configurado?) then (sí)
        :Análisis en SonarQube Cloud\n(quality gate);
      endif
    else (no)
      :Build fallido; <<#FECACA>>
      stop
    endif
  }
end fork
:La PR solo se fusiona\ncon todos los checks en verde;
stop
@enduml
